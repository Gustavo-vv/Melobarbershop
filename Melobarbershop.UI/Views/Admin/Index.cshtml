@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Melo Barber Shop - Desktop Admin Pro</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <link rel="stylesheet" href="~/css/admin-theme.css" />
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col bg-[#08090d] text-slate-100 antialiased selection:bg-cyan-500 selection:text-black">

  <!-- ========================================================================= -->
  <!-- NATIVE DESKTOP WINDOW TITLEBAR (WINDOWS 11 / MACOS COMPATIBLE STYLE) -->
  <!-- ========================================================================= -->
  <header class="h-10 bg-[#0d0f16] border-b border-slate-800/80 flex items-center justify-between px-3 select-none flex-shrink-0 z-50">
    <!-- Left: App Identity & Window Icon -->
    <div class="flex items-center gap-3">
      <!-- App Brand Mini Icon -->
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-gradient-to-tr from-rose-600 via-purple-600 to-sky-500 flex items-center justify-center shadow-sm">
          <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="6" cy="6" r="3"/>
            <circle cx="6" cy="18" r="3"/>
            <line x1="20" y1="4" x2="8.12" y2="15.88"/>
            <line x1="14.47" y1="14.48" x2="20" y2="20"/>
            <line x1="8.12" y1="8.12" x2="12" y2="12"/>
          </svg>
        </div>
        <span class="font-extrabold tracking-wider text-xs uppercase bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-sky-400 font-brand">
          MELO BARBER <span class="text-rose-500 text-[10px] ml-0.5 px-1.5 py-0.5 rounded bg-rose-500/10 border border-rose-500/20">ADMIN v2.4</span>
        </span>
      </div>

      <div class="h-3.5 w-px bg-slate-800 mx-1"></div>

      <!-- Quick Status Indicators -->
      <div class="flex items-center gap-2 text-[11px] text-slate-400">
        <span class="flex items-center gap-1.5 bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Web Sync Ativo
        </span>
        <span class="hidden md:inline-block text-slate-500">•</span>
        <span class="hidden md:inline-flex items-center gap-1 text-slate-400">
          <svg class="w-3 h-3 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          melobarbershop.com.br
        </span>
      </div>
    </div>

    <!-- Center: Search Bar / Quick Command (Ctrl+K) -->
    <div class="hidden lg:flex items-center">
      <button onclick="triggerQuickSearch()" class="flex items-center gap-3 px-3 py-1 bg-[#131622] hover:bg-[#1a1e2f] border border-slate-800 rounded-lg text-xs text-slate-400 hover:text-slate-200 transition-all w-72 justify-between group">
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span>Buscar cliente, corte, agendamento...</span>
        </div>
        <kbd class="text-[10px] bg-slate-800/80 px-1.5 py-0.5 rounded border border-slate-700 text-slate-400 font-mono">Ctrl+K</kbd>
      </button>
    </div>

    <!-- Right: Window Controls (Minimize, Maximize, Close) -->
    <div class="flex items-center gap-2">
      <!-- Live Clock -->
      <div id="liveClock" class="text-[11px] font-mono text-slate-400 mr-2 hidden sm:block">19:54:00</div>
      
      <!-- Botão Voltar ao Site -->
      <a href="/Home/Index" title="Voltar para o site principal" class="flex items-center gap-1.5 px-2.5 py-1 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 text-sky-400 hover:text-sky-300 rounded-lg text-xs font-semibold transition-all">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="hidden sm:inline">Voltar ao Site</span>
      </a>

      <!-- Notifications Icon -->
      <button onclick="showToast('Você tem 3 novos agendamentos feitos pelo site!')" class="relative p-1 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors mr-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span class="absolute top-0.5 right-0.5 w-2 h-2 bg-rose-500 rounded-full animate-ping"></span>
        <span class="absolute top-0.5 right-0.5 w-2 h-2 bg-rose-500 rounded-full"></span>
      </button>

      <!-- Window Action Buttons -->
      <div class="flex items-center -mr-1">
        <button title="Minimizar" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800/60 rounded transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <button title="Maximizar" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800/60 rounded transition-colors">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </button>
        <button title="Fechar" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-white hover:bg-rose-600 rounded transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- MAIN WORKSPACE LAYOUT (SIDEBAR + MAIN CONTENT AREA) -->
  <!-- ========================================================================= -->
  <div class="flex-1 flex overflow-hidden">

    <!-- ==================== LEFT SIDEBAR NAVIGATION ==================== -->
    <aside class="w-64 bg-[#0b0d14] border-r border-slate-800/80 flex flex-col justify-between flex-shrink-0">
      
      <!-- Brand & Navigation Items -->
      <div class="p-3 space-y-6">
        
        <!-- Barber Admin Profile Badge -->
        <div class="p-3 rounded-xl bg-[#121520] border border-slate-800/80 flex items-center gap-3">
          <div class="relative">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-rose-500 via-purple-600 to-sky-500 p-0.5">
              <div class="w-full h-full bg-[#0e1017] rounded-[7px] flex items-center justify-center font-bold text-sky-400 text-sm font-brand">
                MB
              </div>
            </div>
            <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-[#0b0d14] rounded-full"></span>
          </div>
          <div class="overflow-hidden">
            <h4 class="text-xs font-bold text-white truncate flex items-center gap-1.5">
              Melo Master
              <span class="text-[9px] px-1 bg-sky-500/20 text-sky-400 rounded font-normal">Dono</span>
            </h4>
            <p class="text-[11px] text-slate-400 truncate">Gerenciando Unidade 01</p>
          </div>
        </div>

        <!-- Navigation Categories -->
        <div class="space-y-1">
          <div class="px-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2">Painel Operacional</div>

          <!-- Nav Item: Dashboard -->
          <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-semibold text-white bg-sky-500/15 border border-sky-500/30 transition-all">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
              <span>Visão Geral & Métricas</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
          </button>

          <!-- Nav Item: Agenda / Agendamentos -->
          <button onclick="switchTab('agenda')" id="nav-agenda" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-all">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Agenda & Marcações</span>
            </div>
            <span class="px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-rose-500 text-white animate-pulse">4 Web</span>
          </button>

          <!-- Nav Item: Gestão do Site Web (Landing Page CMS) -->
          <button onclick="switchTab('site-cms')" id="nav-site-cms" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-all group">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-rose-400 group-hover:text-rose-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>Controle do Site Web</span>
            </div>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">CMS</span>
          </button>

          <!-- Nav Item: Barbeiros & Cadeiras -->
          <button onclick="switchTab('barbeiros')" id="nav-barbeiros" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-all">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              <span>Barbeiros & Equipe</span>
            </div>
            <span class="text-[10px] text-slate-400">4 Ativos</span>
          </button>

          <!-- Nav Item: Serviços & Preços -->
          <button onclick="switchTab('servicos')" id="nav-servicos" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-all">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242L11 8m2 2l-2-2m-2-2l2-2"/></svg>
              <span>Catálogo & Preços</span>
            </div>
          </button>

          <!-- Nav Item: Financeiro & Caixa -->
          <button onclick="switchTab('financeiro')" id="nav-financeiro" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-all">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Caixa & Financeiro</span>
            </div>
            <span class="text-[10px] text-emerald-400 font-mono font-bold">R$ 2.450</span>
          </button>
        </div>

        <!-- Quick System Settings -->
        <div class="space-y-1">
          <div class="px-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2">Configurações Locais</div>
          
          <button onclick="showToast('Abrindo gerenciador de impressora térmica para cupom')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800/40 transition-all">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span>Impressora Térmica (ESC/POS)</span>
          </button>

          <a href="/Home/Index" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-xs text-sky-400 hover:text-sky-300 hover:bg-sky-500/10 transition-all font-semibold">
            <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Voltar para o Site</span>
          </a>
        </div>

      </div>

      <!-- Sidebar Bottom: Fast Action Button & System Diagnostics -->
      <div class="p-3 border-t border-slate-800/80 space-y-2 bg-[#090a10]">
        <button onclick="openModal('modalNovoAgendamento')" class="w-full py-2.5 px-3 rounded-lg bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-sky-500/20 active:scale-95 transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Novo Agendamento
        </button>

        <div class="flex items-center justify-between text-[10px] text-slate-500 px-1 pt-1">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Servidor Local: 12ms
          </span>
          <span>Porta: 8080</span>
        </div>
      </div>

    </aside>

    <!-- ==================== MAIN CONTENT CANVAS ==================== -->
    <main class="flex-1 flex flex-col overflow-hidden bg-[#07080c]">
      
      <!-- Top Action Bar for Main Canvas -->
      <div class="h-14 border-b border-slate-800/70 bg-[#0c0e15]/70 px-6 flex items-center justify-between flex-shrink-0 backdrop-blur-md">
        
        <!-- Left: Current Section Title & Breadcrumb -->
        <div class="flex items-center gap-3">
          <h1 id="pageTitle" class="text-base font-extrabold tracking-tight text-white font-brand flex items-center gap-2">
            Visão Geral & Dashboard em Tempo Real
          </h1>
          <span class="text-slate-600 text-sm">/</span>
          <span id="pageSubTitle" class="text-xs text-slate-400 font-medium">Hoje, 27 de Agosto de 2026</span>
        </div>

        <!-- Right: Actions, Date Picker & Quick Live Sync -->
        <div class="flex items-center gap-3">
          <!-- Barber Chairs Filter -->
          <div class="flex items-center bg-[#131622] p-1 rounded-lg border border-slate-800 text-xs">
            <button class="px-2.5 py-1 rounded bg-slate-800 text-white font-medium text-[11px] shadow-sm">Todas Cadeiras</button>
            <button class="px-2.5 py-1 rounded text-slate-400 hover:text-white font-medium text-[11px] transition-colors">Cadeira 01 (Melo)</button>
            <button class="px-2.5 py-1 rounded text-slate-400 hover:text-white font-medium text-[11px] transition-colors">Cadeira 02 (Lucas)</button>
          </div>

          <!-- Quick Web Sync Button -->
          <button onclick="syncWithWebsite()" id="btnSyncWeb" class="flex items-center gap-2 px-3 py-1.5 bg-[#141824] hover:bg-slate-800 border border-sky-500/30 rounded-lg text-xs font-semibold text-sky-400 hover:text-sky-300 transition-all shadow-sm">
            <svg id="syncIcon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>Sincronizar Web</span>
          </button>

          <!-- Abrir Caixa / Fechar Caixa -->
          <button onclick="showToast('Status do Caixa: Aberto com R$ 250,00 de fundo')" class="flex items-center gap-2 px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 rounded-lg text-xs font-semibold text-emerald-400 transition-all">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Caixa Aberto</span>
          </button>
        </div>

      </div>

      <!-- Tab Contents Scrollable Container -->
      <div class="flex-1 overflow-y-auto p-6 space-y-6">

        <!-- ================================================================= -->
        <!-- TAB 1: DASHBOARD & REALTIME METRICS (DEFAULT) -->
        <!-- ================================================================= -->
        <div id="tab-dashboard" class="tab-content space-y-6">
          
          <!-- TOP STAT CARDS (Reflects Web Brand: 10h-21h, 20+ Clientes, 2024) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Card 1: Faturamento Hoje -->
            <div class="p-4 rounded-xl bg-[#11141d] border border-slate-800/80 hover:border-slate-700 transition-all relative overflow-hidden group">
              <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-emerald-500/5 rounded-full blur-xl group-hover:bg-emerald-500/10 transition-all"></div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Faturamento Hoje</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-white font-brand">R$ 2.450,00</span>
                <span class="text-xs font-semibold text-emerald-400 flex items-center">+18% vs ontem</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-2">Ticket médio: <strong class="text-slate-300 font-semibold">R$ 68,00</strong> / cliente</p>
            </div>

            <!-- Card 2: Agendamentos & Atendimentos -->
            <div class="p-4 rounded-xl bg-[#11141d] border border-slate-800/80 hover:border-slate-700 transition-all relative overflow-hidden group">
              <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-sky-500/5 rounded-full blur-xl group-hover:bg-sky-500/10 transition-all"></div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Atendimentos / Dia</span>
                <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-white font-brand">28 Clientes</span>
                <span class="text-xs font-semibold text-sky-400">Meta: 20+</span>
              </div>
