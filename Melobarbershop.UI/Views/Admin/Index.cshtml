  <!-- JAVASCRIPT CONTROLLER -->
  <!-- ========================================================================= -->
  <script>
    // Tab switching logic
    function switchTab(tabId) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      
      // Remove active classes on nav
      document.querySelectorAll('.nav-item').forEach(el => {
        el.classList.remove('bg-sky-500/15', 'border-sky-500/30', 'text-white');
        el.classList.add('text-slate-300');
      });

      // Show selected tab
      const targetTab = document.getElementById('tab-' + tabId);
      if (targetTab) {
        targetTab.classList.remove('hidden');
      }

      // Highlight active nav button
      const targetNav = document.getElementById('nav-' + tabId);
      if (targetNav) {
        targetNav.classList.add('bg-sky-500/15', 'border-sky-500/30', 'text-white');
        targetNav.classList.remove('text-slate-300');
      }

      // Update titles
      const titles = {
        'dashboard': { title: 'Visão Geral & Dashboard em Tempo Real', sub: 'Hoje, 27 de Agosto de 2026' },
        'agenda': { title: 'Agenda de Cortes & Atendimentos', sub: 'Sincronizado com Agendamento Online' },
        'site-cms': { title: 'Gerenciador do Site Web (Landing Page)', sub: 'Edição ao vivo dos textos, fotos e horários' },
        'barbeiros': { title: 'Equipe, Cadeiras & Comissões', sub: '4 Profissionais em Atividade' },
        'servicos': { title: 'Tabela de Serviços & Preços', sub: 'Valores visíveis na Landing Page' },
        'financeiro': { title: 'Caixa & Fechamento Financeiro', sub: 'Controle de Entradas e Relatórios' }
      };

      if (titles[tabId]) {
        document.getElementById('pageTitle').textContent = titles[tabId].title;
        document.getElementById('pageSubTitle').textContent = titles[tabId].sub;
      }
    }

    // Live Clock simulation
    setInterval(() => {
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0];
      const clockEl = document.getElementById('liveClock');
      if (clockEl) clockEl.textContent = timeStr;
    }, 1000);

    // Modal helpers
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // Toast notifications
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3500);
    }

    // Save and Publish CMS
    function saveAndPublishCMS() {
      showToast('🚀 Alterações enviadas! Landing page atualizada com sucesso.');
    }

    // Sync with website
    function syncWithWebsite() {
      const icon = document.getElementById('syncIcon');
      icon.classList.add('animate-spin');
      showToast('Sincronizando agendamentos da Landing Page...');
      setTimeout(() => {
        icon.classList.remove('animate-spin');
        showToast('✅ Sincronização concluída! Todos os dados estão atualizados.');
      }, 1200);
    }

    // Quick Search Trigger
    function triggerQuickSearch() {
      showToast('Dica: Use Ctrl+K no teclado para busca rápida em qualquer tela');
    }

    function salvarNovoAgendamento() {
      closeModal('modalNovoAgendamento');
      showToast('✅ Novo agendamento cadastrado com sucesso e bloqueado no site!');
    }
  </script>
