@{
    ViewData["Title"] = "Painel";
    ViewData["ActiveNav"] = "visao-geral";
    ViewData["PageTitle"] = "Visão geral do dia";
    ViewData["PageSubtitle"] = "Terça-feira, 16 de setembro — atualizado agora";
    Layout = "_AdminLayout";
}

@section TopbarActions {
    <div class="filters">
        <div class="seg" id="periodSeg">
            <button data-period="hoje" class="active">Hoje</button>
            <button data-period="semana">Semana</button>
            <button data-period="mes">Mês</button>
        </div>
        <select class="select-filter" id="filterProf">
            <option value="todos">Todos os profissionais</option>
            <option value="melo">Melo</option>
            <option value="lucas">Lucas</option>
            <option value="diego">Diego</option>
            <option value="andre">André</option>
        </select>
        <select class="select-filter" id="filterOrigin">
            <option value="todas">Todas as origens</option>
            <option value="site">Site</option>
            <option value="whatsapp">WhatsApp</option>
            <option value="app">Aplicativo</option>
            <option value="balcao">Balcão</option>
        </select>
        <button class="btn-ghost" onclick="refreshData()">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="refreshIcon"><path d="M4 4v5h.6M20 20v-5h-.6M4.6 9A8 8 0 0 1 19 7.5M19.4 15A8 8 0 0 1 5 16.5" /></svg>
            Atualizar
        </button>
    </div>
}

<!-- error banner -->
<div class="banner hidden" id="errorBanner">
    <span>Não foi possível carregar os dados mais recentes. Exibindo a última versão sincronizada.</span>
    <button onclick="hideBanner()">Tentar novamente</button>
</div>

<!-- dev state simulator (didactic – demonstra os 3 estados de cada bloco) -->
<div class="panel" style="padding:12px 16px;">
    <div class="dev-controls">
        <span>Simular estado dos dados:</span>
        <button id="stateData" class="on" onclick="setDataState('data')">Com dados</button>
        <button id="stateLoading" onclick="setDataState('loading')">Carregando</button>
        <button id="stateEmpty" onclick="setDataState('empty')">Sem dados</button>
        <button id="stateError" onclick="setDataState('error')">Erro de conexão</button>
    </div>
</div>

<!-- ================= KPIs ================= -->
<section>
    <div class="section-head">
        <div><h2>Indicadores do período</h2><p>Calculados a partir dos agendamentos concluídos e vendas do período selecionado.</p></div>
    </div>
    <div class="kpi-grid" id="kpiGrid"><!-- injected --></div>
</section>

<!-- ================= AGENDA + EQUIPE AO VIVO ================= -->
<div class="grid-2">
    <section class="panel">
        <div class="section-head">
            <div><h2>Agenda do dia</h2><p>Agrupada por status. As ações abaixo alteram o status real do agendamento.</p></div>
            <span class="tag" id="agendaCountTag">— agendamentos</span>
        </div>
        <div class="real-content" id="agendaBlock">
            <div class="kanban" id="kanban"><!-- injected --></div>
        </div>
        <div class="state-loading" id="agendaLoading"><div class="spinner"></div>Carregando agenda…</div>
        <div class="state-empty" id="agendaEmpty">Nenhum agendamento encontrado para os filtros selecionados.</div>
    </section>

    <section class="panel">
        <div class="section-head">
            <div><h2>Equipe agora</h2><p>Situação em tempo real de cada profissional.</p></div>
        </div>
        <div class="real-content" id="teamBlock">
            <div class="team-list" id="teamList"><!-- injected --></div>
        </div>
        <div class="state-loading" id="teamLoading"><div class="spinner"></div>Sincronizando equipe…</div>
        <div class="state-empty" id="teamEmpty">Nenhum profissional ativo no momento.</div>
    </section>
</div>

<!-- ================= FINANCEIRO ================= -->
<div class="grid-2">
    <section class="panel">
        <div class="section-head">
            <div><h2>Evolução do faturamento</h2><p>Serviços e produtos, por dia do período.</p></div>
            <div class="chart-legend">
                <span><span class="dot" style="background:var(--blue)"></span>Serviços</span>
                <span><span class="dot" style="background:var(--panel-3);border:1px solid var(--border-strong)"></span>Produtos</span>
            </div>
        </div>
        <div class="real-content" id="revenueBlock">
            <div class="bars-wrap" id="revenueBars"><!-- injected --></div>
        </div>
        <div class="state-loading" id="revenueLoading"><div class="spinner"></div>Calculando faturamento…</div>
        <div class="state-empty" id="revenueEmpty">Sem vendas registradas neste período.</div>
    </section>

    <section class="panel">
        <div class="section-head">
            <div><h2>Formas de pagamento</h2><p>Distribuição do valor recebido.</p></div>
        </div>
        <div class="real-content" id="paymentBlock">
            <div class="donut-wrap">
                <svg width="130" height="130" viewBox="0 0 42 42" id="donutSvg"></svg>
                <div class="donut-legend" id="donutLegend"><!-- injected --></div>
            </div>
        </div>
        <div class="state-loading" id="paymentLoading"><div class="spinner"></div>Somando pagamentos…</div>
        <div class="state-empty" id="paymentEmpty">Nenhum pagamento registrado no período.</div>
    </section>
</div>

<!-- ================= RANKING + ESTOQUE ================= -->
<div class="grid-2">
    <section class="panel">
        <div class="section-head">
            <div><h2>Mais vendidos</h2><p>Serviços e produtos com maior receita no período.</p></div>
        </div>
        <div class="real-content" id="rankBlock">
            <div class="rank-list" id="rankList"><!-- injected --></div>
        </div>
        <div class="state-loading" id="rankLoading"><div class="spinner"></div>Montando ranking…</div>
        <div class="state-empty" id="rankEmpty">Nenhum item vendido no período.</div>
    </section>

    <section class="panel">
        <div class="section-head">
            <div><h2>Estoque baixo</h2><p>Produtos abaixo da quantidade mínima definida.</p></div>
            <span class="tag" id="stockCountTag">—</span>
        </div>
        <div class="real-content" id="stockBlock">
            <div id="stockList"><!-- injected --></div>
        </div>
        <div class="state-loading" id="stockLoading"><div class="spinner"></div>Verificando estoque…</div>
        <div class="state-empty" id="stockEmpty">Nenhum produto abaixo do estoque mínimo. Tudo certo por aqui.</div>
    </section>
</div>

<!-- ================= DESEMPENHO PROFISSIONAIS ================= -->
<section class="panel">
    <div class="section-head">
        <div><h2>Desempenho por profissional</h2><p>Atendimentos, faturamento gerado, comissão e avaliação média no período.</p></div>
    </div>
    <div class="real-content" id="profBlock">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Profissional</th><th>Atendimentos</th><th>Faturamento gerado</th><th>Comissão</th><th>Avaliação</th></tr>
                </thead>
                <tbody id="profTableBody"><!-- injected --></tbody>
            </table>
        </div>
    </div>
    <div class="state-loading" id="profLoading"><div class="spinner"></div>Calculando desempenho…</div>
    <div class="state-empty" id="profEmpty">Nenhum profissional com atendimento no período.</div>
</section>

<!-- ================= ORIGEM + CANCELAMENTOS ================= -->
<div class="grid-2">
    <section class="panel">
        <div class="section-head">
            <div><h2>Origem dos agendamentos</h2><p>De onde vieram os agendamentos do período.</p></div>
        </div>
        <div class="real-content" id="originBlock" style="margin-top:8px;">
            <div id="originList"><!-- injected --></div>
        </div>
        <div class="state-loading" id="originLoading"><div class="spinner"></div>Agrupando origens…</div>
        <div class="state-empty" id="originEmpty">Sem agendamentos no período para calcular origem.</div>
    </section>

    <section class="panel">
        <div class="section-head">
            <div><h2>Cancelamentos e faltas</h2><p>Taxas calculadas sobre o total de agendamentos do período.</p></div>
        </div>
        <div class="real-content" id="cancelBlock">
            <div id="cancelStats"><!-- injected --></div>
        </div>
        <div class="state-loading" id="cancelLoading"><div class="spinner"></div>Calculando taxas…</div>
        <div class="state-empty" id="cancelEmpty">Nenhum cancelamento ou falta registrada no período.</div>
    </section>
</div>

<!-- ================= AVALIAÇÕES ================= -->
<section class="panel">
    <div class="section-head">
        <div><h2>Avaliações recentes</h2><p>Últimos comentários deixados pelos clientes após o atendimento.</p></div>
    </div>
    <div class="real-content" id="reviewBlock">
        <div class="review-grid" id="reviewGrid"><!-- injected --></div>
    </div>
    <div class="state-loading" id="reviewLoading"><div class="spinner"></div>Buscando avaliações…</div>
    <div class="state-empty" id="reviewEmpty">Ainda não há avaliações neste período.</div>
</section>

<!-- gaps needed note -->
<section class="panel" style="border-style:dashed;">
    <div class="section-head">
        <div><h2>Observação de dados</h2><p style="max-width:640px;">Este protótipo usa dados de exemplo para ilustrar cada seção. Em produção, cada número acima precisa vir de uma consulta real aos agendamentos, vendas, pagamentos, estoque e avaliações do período — sem valores fixos como padrão.</p></div>
    </div>
</section>
