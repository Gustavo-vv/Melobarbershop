@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Escolha um serviço - Melo Barber Shop">
  <title>Serviços | Melo Barber Shop</title>
  <link rel="icon" href="~/img/logo.png" type="image/png">
  <link rel="stylesheet" href="~/css/servicos.css" asp-append-version="true" />
</head>

<body>
  <header class="services-header">
    <div class="header-inner">
      <a class="logo-link" href="/" aria-label="Melo Barber Shop">
        <img src="~/img/logo.png" alt="Melo Barber Shop">
      </a>

      <a class="back-link" href="/">← Voltar para a página principal</a>
    </div>

    <button id="serviceThemeToggle" class="theme-toggle" type="button"
            aria-label="Tema claro" aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true">☀</span>
      <span class="theme-toggle-label">Tema claro</span>
    </button>
  </header>

  <main class="page">
    <div class="page-content">
      <div class="steps" aria-label="Etapa do agendamento">
        <span class="active">1 Serviço</span>
        <i></i>
        <span>2 Data e horário</span>
        <i></i>
        <span>3 Confirmar</span>
      </div>

      <section class="service-card">
        <div class="intro">
          <span class="step-number">01</span>
          <div>
            <h1>Escolha o serviço</h1>
            <p>Selecione o serviço que deseja realizar. Depois você será levado para a página de horários.</p>
          </div>
        </div>

        <div class="group">
          <div class="group-title">Serviços populares</div>
          <button class="service-row" type="button" data-service-id="corte" data-service-name="Corte" data-service-duration="30" data-service-price="40">
            <span class="service-main"><strong>Corte</strong><small>30 min</small></span>
            <span class="service-side"><strong>R$ 40,00</strong><span class="select-btn">Selecionar</span></span>
          </button>
          <button class="service-row" type="button" data-service-id="corte-barba" data-service-name="Corte & Barba" data-service-duration="40" data-service-price="60">
            <span class="service-main"><strong>Corte &amp; Barba</strong><small>40 min</small></span>
            <span class="service-side"><strong>R$ 60,00</strong><span class="select-btn">Selecionar</span></span>
          </button>
          <button class="service-row" type="button" data-service-id="barba" data-service-name="Barba" data-service-duration="30" data-service-price="30">
            <span class="service-main"><strong>Barba</strong><small>30 min</small></span>
            <span class="service-side"><strong>R$ 30,00</strong><span class="select-btn">Selecionar</span></span>
          </button>
        </div>

        <div class="group">
          <div class="group-title">Outros serviços</div>
          <button class="service-row" type="button" data-service-id="lavagem" data-service-name="Lavagem" data-service-duration="20" data-service-price="20">
            <span class="service-main"><strong>Lavagem</strong><small>20 min</small></span>
            <span class="service-side"><strong>R$ 20,00</strong><span class="select-btn">Selecionar</span></span>
          </button>
          <button class="service-row" type="button" data-service-id="sobrancelha" data-service-name="Sobrancelha" data-service-duration="15" data-service-price="15">
            <span class="service-main"><strong>Sobrancelha</strong><small>15 min</small></span>
            <span class="service-side"><strong>R$ 15,00</strong><span class="select-btn">Selecionar</span></span>
          </button>
        </div>
      </section>

      <p class="note">
        Ao selecionar um serviço, você continuará para a página de escolha do barbeiro, dia, horário e confirmação.
      </p>
    </div>
  </main>

  <script src="~/js/servicos.js" asp-append-version="true"></script>
</body>
</html>
