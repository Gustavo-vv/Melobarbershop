@model IEnumerable<Melobarbershop.Application.DTOs.ServicoDto>
@{
    Layout = null;
    var servicosLista = Model?.ToList() ?? new List<Melobarbershop.Application.DTOs.ServicoDto>();
    var populares = servicosLista.Take(4).ToList();
    var outros = servicosLista.Skip(4).ToList();
}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Escolha um serviço - Melo Barber Shop">
  <title>Serviços | Melo Barber Shop</title>
  <link rel="icon" href="~/img/logo.png" type="image/png">
  <link rel="stylesheet" href="~/css/servicos.css" asp-append-version="true" />
</head>

<body>
  <header class="services-header">
    <div class="header-inner">
      <a class="logo-link" href="/" aria-label="Melo Barber Shop">
        <img src="~/img/logo.png" alt="Melo Barber Shop">
      </a>

      <a class="back-link" href="/">← Voltar para a página principal</a>
    </div>

    <button id="serviceThemeToggle" class="theme-toggle" type="button"
            aria-label="Tema claro" aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true">☀</span>
      <span class="theme-toggle-label">Tema claro</span>
    </button>
  </header>

  <main class="page">
    <div class="page-content">
      <div class="steps" aria-label="Etapa do agendamento">
        <span class="active">1 Serviço</span>
        <i></i>
        <span>2 Data e horário</span>
        <i></i>
        <span>3 Confirmar</span>
      </div>

      <section class="service-card">
        <div class="intro">
          <span class="step-number">01</span>
          <div>
            <h1>Escolha o serviço</h1>
            <p>Selecione o serviço que deseja realizar. Depois você será levado para a página de horários.</p>
          </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
          <div class="service-feedback error">
            <p>@ViewBag.ErrorMessage</p>
            <button type="button" onclick="location.reload()">Tentar novamente</button>
          </div>
        }
        else if (!servicosLista.Any())
        {
          <div class="service-feedback">
            <p>Nenhum serviço disponível no momento.</p>
          </div>
        }
        else
        {
          @if (populares.Any())
          {
            <div class="group">
              <div class="group-title">Serviços populares</div>
              @foreach (var servico in populares)
              {
                <button class="service-row" type="button"
                        data-service-id="@servico.Id"
                        data-service-name="@servico.Nome"
                        data-service-duration="@servico.DuracaoMinutos"
                        data-service-price="@servico.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                  <span class="service-main">
                    <strong>@servico.Nome</strong>
                    <small>@servico.DuracaoMinutos min</small>
                  </span>
                  <span class="service-side">
                    <strong>@servico.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                    <span class="select-btn">Selecionar</span>
                  </span>
                </button>
              }
            </div>
          }

          @if (outros.Any())
          {
            <div class="group">
              <div class="group-title">Outros serviços</div>
              @foreach (var servico in outros)
              {
                <button class="service-row" type="button"
                        data-service-id="@servico.Id"
                        data-service-name="@servico.Nome"
                        data-service-duration="@servico.DuracaoMinutos"
                        data-service-price="@servico.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                  <span class="service-main">
                    <strong>@servico.Nome</strong>
                    <small>@servico.DuracaoMinutos min</small>
                  </span>
                  <span class="service-side">
                    <strong>@servico.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                    <span class="select-btn">Selecionar</span>
                  </span>
                </button>
              }
            </div>
          }
        }
      </section>

      <p class="note">
        Ao selecionar um serviço, você continuará para a página de escolha do barbeiro, dia, horário e confirmação.
      </p>
    </div>
  </main>

  <script src="~/js/servicos.js" asp-append-version="true"></script>
</body>
</html>
