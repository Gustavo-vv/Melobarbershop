@model Melobarbershop.UI.ViewModels.AgendamentoViewModel
@{
    Layout = null;
    var servico = Model.ServicoSelecionado;
    var servicoNome = servico?.Nome ?? "Corte";
    var servicoDuracao = servico != null ? $"{servico.DuracaoMinutos} min" : "45 min";
    var servicoPrecoFormatado = servico?.PrecoFormatado ?? "R$ 40,00";
    var servicoPrecoInvariante = servico?.PrecoInvariante ?? "40.00";
    var servicoDuracaoMin = servico?.DuracaoMinutos ?? 45;
    var servicoId = servico?.Id.ToString() ?? "";
}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Agendamento online - Melo Barber Shop">
  <title>Agendamento | Melo Barber Shop</title>
  <link rel="icon" type="image/png" href="~/img/logo.png">
  <link rel="stylesheet" href="~/css/agendamento.css" asp-append-version="true" />
</head>
<body>
  <main class="booking-page">
    <div class="topbar">
      <button class="back-btn" type="button" aria-label="Voltar" onclick="history.back()">
        <svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="topbar-actions">
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Mudar tema">
          <span class="theme-icon">☾</span>
          <span id="themeText">Tema preto</span>
        </button>
        <button class="close-btn" type="button" aria-label="Fechar" onclick="location.href='/'">
          <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>

    <div class="booking-layout">
      <section class="schedule-panel" aria-label="Escolha do dia e horário">
        <div class="brand-row">
          <div class="brand-copy">
            <img class="brand-logo" src="~/img/logo.png" alt="Melo Barber Shop">
            <div>
              <div class="eyebrow">Agendamento online</div>
              <h1>Escolha seu <span>horário</span></h1>
            </div>
          </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
          <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px;">
            <p>@Model.MensagemErro</p>
          </div>
        }

        <div class="month-toolbar">
          <div class="month-label" id="monthLabel">Setembro 2026</div>
          <div class="month-controls">
            <button class="month-btn" id="prevMonth" type="button" aria-label="Mês anterior">‹</button>
            <div class="month-picker">
              <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
              <span id="monthPickerLabel">Setembro 2026</span>
            </div>
            <button class="month-btn" id="nextMonth" type="button" aria-label="Próximo mês">›</button>
          </div>
        </div>

        <div class="notice" id="notice">
          <strong>Precisa de mais datas?</strong>
          Expanda para a visualização do mês completo.
          <button class="notice-close" id="noticeClose" type="button" aria-label="Fechar aviso">×</button>
        </div>

        <div class="days-wrap" id="daysWrap"></div>

        <div class="times">
          <div class="available-times-title">Horários disponíveis</div>
          <div class="time-list" id="timeList"
               data-initial-date="@DateTime.Today.ToString("yyyy-MM-dd")"
               data-initial-barber-id="@(Model.BarbeirosDisponiveis.FirstOrDefault()?.Id ?? "")">
            @if (Model.HorariosDisponiveis.Any())
            {
              @foreach (var horario in Model.HorariosDisponiveis)
              {
                var classeExtra = horario.Disponivel ? "" : "unavailable";
                <button class="time-btn @classeExtra"
                        data-time="@horario.Label"
                        data-value="@horario.Valor"
                        type="button"
                        @(horario.Disponivel ? "" : "disabled")>
                  @horario.Label
                </button>
              }
            }
            else
            {
              <div class="empty-time">Não há horários disponíveis para hoje. Escolha outro dia.</div>
            }
          </div>
        </div>
      </section>

      <aside class="order-card" aria-label="Resumo do pedido">
        <h2>Seu pedido</h2>
        <div class="service-box">
          <div class="service-main">
            <div>
              <div class="service-name" id="serviceName"
                   data-service-id="@servicoId"
                   data-service-duration="@servicoDuracaoMin"
                   data-service-price="@servicoPrecoInvariante">@servicoNome</div>
              <div class="service-duration" id="serviceDuration">@servicoDuracao</div>
            </div>
            <div class="service-price" id="servicePrice">@servicoPrecoFormatado</div>
          </div>

          <div class="divider"></div>

          <div class="team-title">Equipe disponível</div>
          <div class="team-list">
            @for (int i = 0; i < Model.BarbeirosDisponiveis.Count; i++)
            {
              var b = Model.BarbeirosDisponiveis[i];
              var isSelected = i == 0 ? "selected" : "";
              <button class="barber @isSelected" data-barber="@b.Nome" data-barber-id="@b.Id" type="button">
                <span class="avatar">@b.Inicial</span>
                <span class="barber-name">@b.Nome <span class="preference-dot"></span></span>
                <span class="rating">★ 5,0</span>
              </button>
            }
          </div>
        </div>

        <div class="order-actions">
          <button class="add-service" type="button" onclick="location.href='/Servicos'">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            Adicionar outro serviço
          </button>

          <div class="total-row">
            <span>Total</span>
            <span id="totalPrice">@servicoPrecoFormatado</span>
          </div>

          <button class="continue-btn" id="continueBtn" type="button"
                  data-logado="@(Model.UsuarioLogado ? "true" : "false")">
            @(Model.UsuarioLogado ? "Continuar" : "Fazer login para continuar")
          </button>
        </div>

        <p style="color:#7e8a97;font-size:11px;margin-top:12px;text-align:center">
          <span id="selectedDayLabel">11 de setembro</span> • <span id="barberSummary">@(Model.BarbeirosDisponiveis.FirstOrDefault()?.Nome ?? "Guilherme")</span>
        </p>
    </div>
  </main>

  <!-- Modal / Popup pós-agendamento -->
  <div class="booking-modal-backdrop" id="bookingModalBackdrop" style="display:none;">
    <div class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="booking-modal-header">
        <div class="modal-title-group">
          <svg class="modal-check-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="#087cff" stroke-width="1.5"/>
            <path d="M7.5 12.5l3 3 6-6" stroke="#087cff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h2 class="modal-title" id="modalTitle">Agendamento confirmado</h2>
        </div>
        <button class="modal-close-btn" id="btnFecharModal" type="button" aria-label="Fechar">&#x2715;</button>
      </div>
      <div class="booking-modal-body">
        <p class="modal-intro">Seu horário foi reservado no sistema da barbearia.</p>
        <div class="modal-ticket-divider"></div>
        <div class="modal-summary-box">
          <div class="summary-item">
            <span class="summary-label">Serviço</span>
            <span class="summary-val" id="modalServico">-</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Profissional</span>
            <span class="summary-val" id="modalBarbeiro">-</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Data e horário</span>
            <span class="summary-val" id="modalDataHora">-</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Valor</span>
            <span class="summary-val highlight" id="modalValor">-</span>
          </div>
        </div>
      </div>
      <div class="booking-modal-footer">
        <button class="btn-modal-primary" id="btnConcluirModal" type="button" onclick="location.href='/'">Voltar ao início</button>
        <button class="btn-modal-ghost" id="btnNovoAgendamento" type="button">Agendar outro horário</button>
      </div>
    </div>
  </div>

  <script src="~/js/agendamento.js" asp-append-version="true"></script>
</body>
</html>
