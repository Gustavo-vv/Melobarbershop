@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro - Melo Barber Shop</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <link rel="stylesheet" href="~/css/cadastro.css" />
</head>
<body class="min-h-screen w-full bg-[#08090d] text-slate-100 flex items-center justify-center p-4 relative overflow-hidden py-10">
  
  <!-- Background Glow Effects -->
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-emerald-600/20 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- Register Container -->
  <div class="w-full max-w-md z-10">
    <div class="glass-panel-login border border-slate-800 rounded-3xl p-8 shadow-2xl relative overflow-hidden">
      
      <!-- Top Accent Line -->
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 via-sky-500 to-purple-500"></div>

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-2xl font-black text-white font-brand tracking-wider">CRIAR CONTA</h1>
        <p class="text-sm text-slate-400 mt-1">Junte-se à Melo Barber Shop</p>
      </div>

      <!-- Form -->
      <form action="/Auth/Cadastro" method="POST" class="space-y-4">
        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1.5">Nome Completo</label>
          <input type="text" name="nome" required placeholder="Seu nome" 
                 class="w-full px-4 py-2.5 rounded-xl bg-[#0b0d14] border border-slate-800 text-sm text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all outline-none">
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1.5">E-mail</label>
          <input type="email" name="email" required placeholder="seu@email.com" 
                 class="w-full px-4 py-2.5 rounded-xl bg-[#0b0d14] border border-slate-800 text-sm text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all outline-none">
        </div>
        
        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1.5">Senha</label>
          <input type="password" name="password" required placeholder="Crie uma senha forte" 
                 class="w-full px-4 py-2.5 rounded-xl bg-[#0b0d14] border border-slate-800 text-sm text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all outline-none">
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1.5">Confirmar Senha</label>
          <input type="password" name="confirmPassword" required placeholder="Repita a senha" 
                 class="w-full px-4 py-2.5 rounded-xl bg-[#0b0d14] border border-slate-800 text-sm text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all outline-none">
        </div>

        <button type="submit" class="w-full mt-2 py-3.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-sm flex items-center justify-center shadow-lg shadow-sky-500/25 active:scale-[0.98] transition-all">
          CADASTRAR E ENTRAR
        </button>
      </form>

      <!-- Footer Links -->
      <div class="mt-8 text-center border-t border-slate-800/80 pt-6">
        <p class="text-xs text-slate-400">
          Já possui conta? 
          <a href="/Auth/Login" class="text-sky-400 font-bold hover:text-sky-300 transition-colors ml-1">Fazer Login</a>
        </p>
      </div>

    </div>
  </div>

</body>
</html>
