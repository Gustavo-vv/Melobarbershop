@model Melobarbershop.UI.ViewModels.CadastroViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Crie sua conta na Melo Barber Shop e facilite seus próximos agendamentos.">
    <title>Criar Conta | Melo Barber Shop</title>
    <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true">
</head>
<body class="register-body">
    <main class="register-page">
        <section class="register-visual" aria-label="Melo Barber Shop">
            <a href="/Auth/Login" class="register-back" aria-label="Voltar para o login">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                <span>Voltar para o login</span>
            </a>

            <div class="register-visual-content">
                <a href="/" aria-label="Voltar para a página inicial">
                    <img src="~/img/logo.png" alt="Melo Barber Shop" class="register-logo" width="150" height="175">
                </a>
                <span class="register-eyebrow">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3l15 15M3 6l15 15M8 8l8 8M16 8l-8 8"/></svg>
                    Faça parte da família
                </span>
                <h1>Crie sua <span>conta</span></h1>
                <div class="register-accent"></div>
                <p>Preencha os dados abaixo para criar sua conta e agendar seus próximos cortes com praticidade.</p>
            </div>
        </section>

        <section class="register-form-side" aria-labelledby="register-title">
            <div class="register-progress" aria-label="Etapa 1 de 3">
                <div class="register-step active">
                    <div class="register-step-number">1</div>
                    <span>DADOS</span>
                </div>
                <div class="register-line active"></div>
                <div class="register-step">
                    <div class="register-step-number">2</div>
                    <span>CONFIRMAÇÃO</span>
                </div>
                <div class="register-line"></div>
                <div class="register-step">
                    <div class="register-step-number">3</div>
                    <span>CONCLUÍDO</span>
                </div>
            </div>

            <form id="registerForm" action="/Auth/Cadastro" method="POST" novalidate>
                <h2 id="register-title" class="sr-only">Criar sua conta</h2>

                <div class="register-row">
                    <div class="register-field">
                        <label for="nome">Nome completo</label>
                        <div class="register-input">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg>
                            <input type="text" id="nome" name="nome" value="@Model.Nome" autocomplete="name" placeholder="Digite seu nome completo" required>
                        </div>
                    </div>
                    <div class="register-field">
                        <label for="email">E-mail</label>
                        <div class="register-input">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 7l9 7 9-7"/></svg>
                            <input type="email" id="email" name="email" value="@Model.Email" autocomplete="email" placeholder="Digite seu e-mail" required>
                        </div>
                    </div>
                </div>

                <div class="register-row">
                    <div class="register-field">
                        <label for="telefone">Telefone</label>
                        <div class="register-input">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5l3 1.5-1.8 3.5a16 16 0 0 0 7.8 7.8l3.5-1.8 1.5 3a2 2 0 0 1-2.2 2.9A18 18 0 0 1 3.6 5.7 2 2 0 0 1 6.5 3.5z"/></svg>
                            <input type="tel" id="telefone" name="telefone" value="@Model.TelefoneWhatsApp" autocomplete="tel" inputmode="tel" placeholder="(11) 99999-9999">
                        </div>
                    </div>
                    <div class="register-field">
                        <label for="nascimento">Data de nascimento</label>
                        <div class="register-input">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
                            <input type="date" id="nascimento" name="nascimento" value="@(Model.DataNascimento?.ToString("yyyy-MM-dd"))" autocomplete="bday" min="1900-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                </div>

                <div class="register-field">
                    <label for="senha">Senha</label>
                    <div class="register-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input type="password" id="senha" name="password" autocomplete="new-password" placeholder="Crie uma senha" minlength="8" required>
                        <button type="button" class="register-eye" data-target="senha" aria-label="Mostrar senha">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>
                <div class="register-field">
                    <label for="confirmarSenha">Confirmar senha</label>
                    <div class="register-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input type="password" id="confirmarSenha" name="confirmarSenha" autocomplete="new-password" placeholder="Confirme sua senha" minlength="8" required>
                        <button type="button" class="register-eye" data-target="confirmarSenha" aria-label="Mostrar confirmação de senha">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>

                <label class="register-terms">
                    <input type="checkbox" id="termos" name="termos" required>
                    <span>Eu aceito os <a asp-controller="Auth" asp-action="Termos" target="_blank" rel="noopener">Termos de Uso</a> e a <a asp-controller="Auth" asp-action="Privacidade" target="_blank" rel="noopener">Política de Privacidade</a></span>
                </label>

                <button type="submit" class="register-submit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M16 11h6"/></svg>
                    Criar conta
                </button>

                <p class="register-already">Já tem uma conta? <a href="/Auth/Login">Fazer login</a></p>
                <div class="register-message @(!string.IsNullOrEmpty(Model.MensagemErro) ? "error" : !string.IsNullOrEmpty(Model.MensagemSucesso) ? "success" : "")" id="message" aria-live="polite">@(!string.IsNullOrEmpty(Model.MensagemErro) ? Model.MensagemErro : Model.MensagemSucesso)</div>
            </form>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/imask/7.6.1/imask.min.js"></script>
    <script>
        const telefoneInput = document.getElementById('telefone');
        const telefoneMask = IMask(telefoneInput, {
            mask: '(00) 00000-0000'
        });

        document.querySelectorAll('.register-eye').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                const visible = input.type === 'text';
                input.type = visible ? 'password' : 'text';
                button.setAttribute('aria-label', visible ? 'Mostrar senha' : 'Ocultar senha');
            });
        });

        document.getElementById('registerForm').addEventListener('submit', async event => {
            event.preventDefault();
            const form = event.currentTarget;
            const message = document.getElementById('message');
            const submitBtn = form.querySelector('.register-submit');

            const nome = document.getElementById('nome').value.trim();
            const email = document.getElementById('email').value.trim();
            const telefone = document.getElementById('telefone').value.trim();
            const nascimento = document.getElementById('nascimento').value;
            const senha = document.getElementById('senha').value;
            const confirmarSenha = document.getElementById('confirmarSenha').value;
            const termos = document.getElementById('termos').checked;

            if (!nome || !email || !telefone || !senha || !confirmarSenha) {
                message.textContent = 'Por favor, preencha todos os campos obrigatórios.';
                message.className = 'register-message error';
                return;
            }

            if (!telefoneMask.masked.isComplete) {
                message.textContent = 'Por favor, insira um número de telefone celular válido e completo com DDD.';
                message.className = 'register-message error';
                return;
            }

            if (nascimento) {
                const anoStr = nascimento.split('-')[0];
                const ano = parseInt(anoStr, 10);
                const anoAtual = new Date().getFullYear();
                if (!/^\d{4}$/.test(anoStr) || isNaN(ano) || ano < 1900 || ano > anoAtual) {
                    message.textContent = 'Por favor, insira uma data de nascimento com ano válido (entre 1900 e ' + anoAtual + ').';
                    message.className = 'register-message error';
                    return;
                }
            }

            if (!termos) {
                message.textContent = 'Você deve aceitar os termos de uso para prosseguir.';
                message.className = 'register-message error';
                return;
            }

            if (senha.length < 6) {
                message.textContent = 'A senha deve ter no mínimo 6 caracteres.';
                message.className = 'register-message error';
                return;
            }

            if (senha !== confirmarSenha) {
                message.textContent = 'As senhas não conferem.';
                message.className = 'register-message error';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Criando conta...';
            message.textContent = '';
            message.className = 'register-message';

            try {
                const payload = {
                    nome: nome,
                    email: email,
                    telefoneWhatsApp: telefone,
                    senha: senha,
                    confirmarSenha: confirmarSenha,
                    dataNascimento: nascimento ? new Date(nascimento).toISOString() : null
                };

                const response = await fetch('/Auth/Cadastro', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json().catch(() => null);

                if (response.ok && data && data.sucesso) {
                    message.textContent = data.mensagem || 'Cadastro realizado com sucesso! Redirecionando para o login...';
                    message.className = 'register-message success';
                    setTimeout(() => {
                        window.location.href = '/Auth/Login';
                    }, 1500);
                } else {
                    const erro = (data && data.mensagem) ? data.mensagem : 'Erro ao cadastrar usuário. Verifique seus dados.';
                    message.textContent = erro;
                    message.className = 'register-message error';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Criar conta';
                }
            } catch (err) {
                message.textContent = 'Falha ao conectar com o servidor. Verifique sua conexão.';
                message.className = 'register-message error';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Criar conta';
            }
        });
    </script>
</body>
</html>
